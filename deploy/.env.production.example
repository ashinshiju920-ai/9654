# ==============================================================================
# Aylem Learning Student Portal — Production Environment Variables
# Copy to /var/www/aylem-portal/.env.production (chmod 600)
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# PostgreSQL Database (Internal connection on IndiaHost VPS)
DATABASE_URL=postgresql://aylem_app:STRONG_RANDOM_PASSWORD_HERE@127.0.0.1:5432/aylem_portal

# Registration Policy (Must remain false in production — accounts are provisioned upon enrollment)
ALLOW_PUBLIC_SIGNUP=false

# Cloudflare R2 Private PDF Storage (S3-compatible API credentials)
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
